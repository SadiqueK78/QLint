# Python
.venv/
backend/__pycache__/
backend/**/__pycache__/
*.pyc
.pytest_cache/

# Secrets — never commit
backend/.env

# Frontend
frontend/node_modules/
frontend/dist/
# Per-machine Vite config, from frontend/.env.example. Listed file by file
# rather than as frontend/.env* so the .example template stays tracked.
frontend/.env
frontend/.env.local
frontend/.env.*.local

# Docker — per-machine compose tweaks, from the .example file
docker-compose.override.yml

# Editor/OS noise
.vscode/
.idea/
.DS_Store