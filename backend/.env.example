GITHUB_TOKEN=your_token_here
MONGODB_URI=mongodb://localhost:27017
JWT_SECRET=change_this_to_a_random_64_char_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
SCAN_CACHE_TTL_HOURS=24
ADMIN_SECRET=change_this_admin_secret
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/auth/github/callback
# Scope asked for by the separate "Connect write access" flow that creates
# migration pull requests. public_repo is the narrowest OAuth App scope that
# can create a branch, a commit and a pull request, and it covers public
# repositories only. Set it to `repo` only if your users need this for private
# repositories, and note that `repo` also grants read access to every private
# repository they can see.
GITHUB_WRITE_OAUTH_SCOPE=public_repo
FRONTEND_URL=http://localhost:5174
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini
# Migration patches only. Needs a model that can reproduce a file's lines byte
# for byte in a unified diff -- weaker models drop blank lines and the patch
# then cannot be applied. Leave unset to use the tested default.
OPENROUTER_PATCH_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_SITE_URL=http://localhost:5174
OPENROUTER_SITE_NAME=QLint
