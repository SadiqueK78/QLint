# Default frontend config for local development. Committed on purpose: it
# holds no secrets, and it documents the value the app expects.
#
# Only VITE_-prefixed variables reach the browser bundle -- that is Vite's
# rule, and it is a safety feature: anything in here is readable by anyone
# who loads the site. Never put a key or token in this file.
#
# For a per-machine override (a backend on another host or port), create
# frontend/.env.local instead. Vite loads it after this file, it wins, and it
# is gitignored so it never lands in a commit.

VITE_API_URL=http://localhost:8000
