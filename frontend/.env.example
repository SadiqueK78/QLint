# Template for frontend/.env. Copy it and edit as needed:
#
#   cp frontend/.env.example frontend/.env
#
# The copy is gitignored, so per-machine settings never land in a commit.
# This file is the committed record of which variables the frontend reads.
#
# Nothing here is required to run locally: frontend/src/api.js falls back to
# the same default below when no .env exists, so a fresh clone works with no
# setup. Create the .env when you need to point at a different backend.
#
# Only VITE_-prefixed variables reach the browser bundle -- that is Vite's
# rule, and it is a safety feature: anything in a .env here is readable by
# anyone who loads the site. Never put a key or token in one.

VITE_API_URL=http://localhost:8000
